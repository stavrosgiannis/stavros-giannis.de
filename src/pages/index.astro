---
import Base from "../layouts/Base.astro";
import { site, highlights, experience, projects, skills } from "../data/site";
---

<Base>
  <section class="hero">
    <p class="eyebrow">{site.role} · {site.location}</p>
    <h1>{site.name}</h1>
    <p class="lead">{site.intro}</p>
    <p class="actions">
      <a class="button" href={`mailto:${site.email}`}>Get in touch</a>
      {site.links.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}
    </p>
  </section>

  <section aria-label="Highlights" class="stats">
    {highlights.map((h) => (
      <div>
        <p class="stat">{h.value}</p>
        <p class="muted">{h.label}</p>
      </div>
    ))}
  </section>

  <section id="experience">
    <h2>Experience</h2>
    {experience.map((job) => (
      <article class="job">
        <div class="job-head">
          <h3>{job.role} <span class="muted">· {job.company}</span></h3>
          <p class="mono muted">{job.period}</p>
        </div>
        {job.summary && <p>{job.summary}</p>}
        <ul>{job.points.map((p) => <li>{p}</li>)}</ul>
      </article>
    ))}
  </section>

  <section id="work">
    <h2>Selected work</h2>
    <div class="cards">
      {projects.map((p) => (
        <article class="card">
          <h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
          <p>{p.description}</p>
          <p class="tags">{p.tags.map((t) => <span>{t}</span>)}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="skills">
    <h2>Toolbox</h2>
    <dl class="skills">
      {skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>{s.items.join(", ")}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <p>
      The best way to reach me is email: <a href={`mailto:${site.email}`}>{site.email}</a>.
      My full CV is available on request.
    </p>
  </section>
</Base>
